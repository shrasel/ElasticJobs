# ==============================================================================
# ElasticJobs Monorepo Environment Configuration
# ==============================================================================

# Elasticsearch
ES_VERSION=8.15.2
ES_PORT=9200
ES_JAVA_OPTS=-Xms256m -Xmx384m

# Backend Service
BACKEND_PORT=8090
SPRING_PROFILES_ACTIVE=prod
BACKEND_JAVA_OPTS=-XX:+UseZGC -XX:+ZGenerational -Xms256m -Xmx512m

# Frontend
FRONTEND_PORT=3000
