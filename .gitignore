# ==============================================================================
# Monorepo Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
*.swp
*.swo
*~

# Java / Maven (Backend)
backend/target/
**/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# Node / NPM / Vite (Frontend)
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.eslintcache

# Docker & Containers
.docker/
docker/data/
**/elasticsearch/data/
docker/*.env
!docker/.env.example

# Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Logs
logs/
*.log

# Scratch / Temporary
scratch/
tmp/
.temp/
